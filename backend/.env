# ─── Database ─────────────────────────────────────────────────────────────────
# Leave empty to run without PostgreSQL (mock evidence will be used)
DATABASE_URL=

# ─── AI / Reasoning ──────────────────────────────────────────────────────────
# Set your Gemini API key for real AI-powered claim extraction and verdict assessment
# Get one at https://aistudio.google.com/
# Leave empty to use deterministic mock mode
GEMINI_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Upload ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=20971520

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
