# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/evidencelens
# For Supabase: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ─── AI Services ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Upload limits ────────────────────────────────────────────────────────────
# Maximum allowed media upload size in bytes (default: 20 MB)
MAX_UPLOAD_BYTES=20971520

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | production
