# ─── Database Configuration ───────────────────────────────────────────────────
# PostgreSQL connection string with pgvector support.
# Formats accepted: postgresql://, postgres://, or postgresql+asyncpg://
#
# Option A - Local Docker / PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidencelens
#
# Option B - Supabase (Direct Connection):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Option C - Supabase (Connection Pooler / IPv4):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Option D - Neon:
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
DATABASE_URL=

# ─── AI / Reasoning Services ──────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Upload limits ────────────────────────────────────────────────────────────
# Maximum allowed media upload size in bytes (default: 20 MB)
MAX_UPLOAD_BYTES=20971520

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | production
